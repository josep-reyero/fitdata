[Unit]
Description=fitdata: check Garmin Connect for new activities
After=network-online.target

[Service]
Type=oneshot
# 75 = temporary: another sync held the lock or Garmin was rate limiting. The next run carries on.
SuccessExitStatus=75
# The same limits as the job in apps/fitdata_garmin/app.toml: memory, time, and no new privileges.
# UMask keeps the archive, the index and the logs readable by the owner only.
MemoryMax=512M
TimeoutStartSec=20m
NoNewPrivileges=yes
UMask=0077
ExecStart=%h/.local/bin/fitdata-garmin --local activities-sync --days 2
