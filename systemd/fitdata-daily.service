[Unit]
Description=fitdata: refresh the last 3 days (health data, sleep, HRV, readiness, activities)
After=network-online.target

[Service]
Type=oneshot
# 75 = temporary: another sync held the lock or Garmin was rate limiting. The next run carries on.
SuccessExitStatus=75
ExecStart=%h/.local/bin/fitdata --local sync --days 3
