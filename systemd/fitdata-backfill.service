[Unit]
Description=fitdata: fill in older history (a slice per night)
After=network-online.target

[Service]
Type=oneshot
# 75 = temporary: another sync held the lock or Garmin was rate limiting. The next run carries on.
SuccessExitStatus=75
# The same limits as the job in project.toml: memory, time, and nothing it starts gains privileges.
# UMask keeps the archive, the index and the logs readable by the owner only.
MemoryMax=512M
TimeoutStartSec=3h
NoNewPrivileges=yes
UMask=0077
ExecStart=%h/.local/bin/fitdata --local backfill --max-days 90
